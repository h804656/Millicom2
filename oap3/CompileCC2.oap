\**\EqualWait.Set=
>{Sep="=" Lex.ReceiverMkSet=EqualAfter.FindAnd Console.OutLn="EqualWait ="}
>{Sep="}" Lex.ReceiverMkSet=Root.FindAnd Lex.SendToReceiver}
>{0 Lex.ReceiverMkSet=Root.FindAnd FUListNew.ReceivedOutMk=Lex.SendToReceiver}

\**\EqualAfter.Set=
>{Sep=">" Lex.ReceiverMkSet=ListStart.FindAnd Console.OutLn="EqualAfter >"
  OAList.LineCopyAddPrevLoadSet={Obj}}
>{Const ConstInt Var MkExtend Atr Lex.ReceiverMkSet=EqVar.FindAnd  Console.OutLn="EqualAfter Const"}
>{IC Lex.ReceiverMkSet=Root.FindAnd FUListNew.ReceivedLoadOutMk=OAList.LastLoadSet}
>{MkBegRange FUTypeDef Lex.ReceiverMkSet=FUAfter2.FindAnd FUListNew.ReceivedLoadOutMk=MkCalc.Set}
>{FUType Lex.ReceiverMkSet=FUAfter2.FindAnd MkCalc.Set=0}
>{Sep="{" Lex.ReceiverMkSet=Root.FindAnd OAList.LineCopyAddPrevLoadSet Console.OutLn="EqualAfter {"
	Stack.EmptyExec={Main_Bus.FuSwapNext=Root.Reset Console.OutLn="FU Swap!!!"}
	Stack.LineCopyAdd={Sep="{"} Stack.OutMk=Console.OutLn
}
>{Mnemo Lex.ReceiverMkSet=MnemoLoad.FindAnd Console.OutLn="EqualAfter mnemo"}
>{Sep=">" Lex.ReceiverMkSet= Console.OutLn="EqualAfter >"}
>{0 Console.OutLn="Ip load is expected" Lex.Stop EqualAfter.ReceivedOutMk=Console.OutLn}


\**\MnemoLoad.Set=
>{Sep="(" Lex.ReceiverMkSet=LoadVar.FindAnd Console.OutLn="MnemoLoad ("}
>{Sep="{" Lex.ReceiverMkSet=Root.FindAnd Console.OutLn="MnemoLoad {" 
	EqualAfter.ReceivedOutMk=MnemoTable.LineCopyAdd MnemoTable.LastAttach={IC}
	OAList.LineCopyAddPrevLoadSet OAList.LastOutMk=MnemoTable.LastLoadSet
	Stack.LineCopyAdd={Sep="{"}
}
>{0 Lex.Stop Console.OutLn="Wrong mnemonic desription"}

