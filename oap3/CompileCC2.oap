\**\LoadAfterMk.Set=
>{Sep="="}
>{Sep="}" Lex.ReceiverMkSet=Root.FindAnd Lex.SendToReceiver Console.OutLn="LoadAfterMk }"}
>{0 Lex.ReceiverMkSet=Root.FindAnd Console.OutLn="LoadAfterMk else" Lex.OutMk=ConsoleOutLn FUListNew.ReceivedOutMk=Root.FindAnd}

\\ ===========================================================================
\\ ALE2026 expression grammar (recognizer) -- pure OAP, no native Ale* calls.
\\ Source spec: oap3/ALE2026.tree.md. Each handler mirrors one grammar state;
\\ token transitions use Lex.ReceiverMkSet, bracket nesting uses the Stack FU,
\\ termination re-dispatches the terminator to Root via Lex.SendToReceiver.
\\ Console.OutLn traces follow the "<State> <token>" project convention.
\\ ===========================================================================

\**\ALEStart.Set=
>{Mk MkExtend Lex.ReceiverMkSet=EgAleWait2.FindAnd Console.OutLn="ALEStart Mk" Cons.OutLn="ALEStart Mk"}
>{Var Lex.ReceiverMkSet=VarAfter.FindAnd Console.OutLn="ALEStart Var" Cons.OutLn="ALEStart Var"}
>{Vect Lex.ReceiverMkSet=VectAfter.FindAnd Console.OutLn="ALEStart Vect" Cons.OutLn="ALEStart Vect"}
>{0 Lex.Stop Console.OutLn="SYNTAX ERROR ALEStart: Mk, Var or Vect expected" Cons.OutLn="ALEStart ERR"}

\**\VarAfter.Set=
>{Sep="++" Sep="--" Lex.ReceiverMkSet=Root.FindAnd Console.OutLn="VarAfter ++/-- (End)" Cons.OutLn="VarAfter ++/-- End"
  FUListNew.ReceivedOutMk=Lex.SendToReceiver}
>{Sep="," Lex.ReceiverMkSet=EgVectProcess.FindAnd Console.OutLn="VarAfter ," Cons.OutLn="VarAfter ,"}
>{Sep="=" Lex.ReceiverMkSet=AleEgAfter.FindAnd Console.OutLn="VarAfter =" Cons.OutLn="VarAfter ="}
>{Operator Lex.ReceiverMkSet=AleEgAfter.FindAnd Console.OutLn="VarAfter Operator=" Cons.OutLn="VarAfter Operator="}
>{0 Lex.Stop Console.OutLn="SYNTAX ERROR VarAfter: '=', Operator, ',', '++' or '--' expected" Cons.OutLn="VarAfter ERR"}

\**\AleEgAfter.Set=
>{Var Const ConstInt ConstFloat Lex.ReceiverMkSet=OperatWait.FindAnd Console.OutLn="AleEgAfter operand" Cons.OutLn="AleEgAfter operand"}
>{Vect Lex.ReceiverMkSet=VectAfter2.FindAnd Console.OutLn="AleEgAfter Vect" Cons.OutLn="AleEgAfter Vect"}
>{Func Lex.ReceiverMkSet=FuncAfter.FindAnd Console.OutLn="AleEgAfter Func" Cons.OutLn="AleEgAfter Func"}
>{Sep="(" Stack.LineCopyAdd={Sep="("} Console.OutLn="AleEgAfter ( (push)" Cons.OutLn="AleEgAfter ( push"}
>{Sep="{" Stack.LineCopyAdd={Sep="{"} Console.OutLn="AleEgAfter { (push)" Cons.OutLn="AleEgAfter { push"}
>{0 Lex.Stop Console.OutLn="SYNTAX ERROR AleEgAfter: operand, Func, '(' or '{' expected" Cons.OutLn="AleEgAfter ERR"}

\**\OperatWait.Set=
>{Operator Lex.ReceiverMkSet=AleEgAfter.FindAnd Console.OutLn="OperatWait Operator" Cons.OutLn="OperatWait Operator"}
>{Sep="+" Sep="-" Sep="*" Sep="/" Sep="//" Sep="%"
  Lex.ReceiverMkSet=AleEgAfter.FindAnd Console.OutLn="OperatWait op" Cons.OutLn="OperatWait op"}
>{Sep="++" Sep="--" Lex.ReceiverMkSet=Root.FindAnd Console.OutLn="OperatWait ++/-- (End)" Cons.OutLn="OperatWait ++/-- End"
  FUListNew.ReceivedOutMk=Lex.SendToReceiver}
>{Sep=")" Stack.FindAndLast={Sep="("}
  Stack.SuccessExec={Stack.LastDelMk Console.OutLn="OperatWait ) pop" Cons.OutLn="OperatWait ) pop"}
  Stack.FailExec={Lex.ReceiverMkSet=Root.FindAnd Console.OutLn="OperatWait ) -> Root (End)" Cons.OutLn="OperatWait ) End"
                  FUListNew.ReceivedOutMk=Lex.SendToReceiver}}
>{Sep="}" Stack.FindAndLast={Sep="{"}
  Stack.SuccessExec={Stack.LastDelMk Console.OutLn="OperatWait } pop" Cons.OutLn="OperatWait } pop"}
  Stack.FailExec={Lex.ReceiverMkSet=Root.FindAnd Console.OutLn="OperatWait } -> Root (End)" Cons.OutLn="OperatWait } End"
                  FUListNew.ReceivedOutMk=Lex.SendToReceiver}}
>{Sep="]" Stack.FindAndLast={Sep="["}
  Stack.SuccessExec={Stack.LastDelMk Console.OutLn="OperatWait ] pop" Cons.OutLn="OperatWait ] pop"}
  Stack.FailExec={Lex.ReceiverMkSet=Root.FindAnd Console.OutLn="OperatWait ] -> Root (End)" Cons.OutLn="OperatWait ] End"
                  FUListNew.ReceivedOutMk=Lex.SendToReceiver}}
>{0 Lex.ReceiverMkSet=Root.FindAnd Console.OutLn="OperatWait End -> Root" Cons.OutLn="OperatWait End -> Root"
  FUListNew.ReceivedOutMk=Lex.SendToReceiver}

\**\EgAleWait2.Set=
>{Sep="," Lex.ReceiverMkSet=EgVectProcess.FindAnd Console.OutLn="EgAleWait2 ," Cons.OutLn="EgAleWait2 ,"}
>{Sep="=" Lex.ReceiverMkSet=EqAfter.FindAnd Console.OutLn="EgAleWait2 =" Cons.OutLn="EgAleWait2 ="}
>{0 Lex.Stop Console.OutLn="SYNTAX ERROR EgAleWait2: ',' or '=' expected" Cons.OutLn="EgAleWait2 ERR"}

\**\EgVectProcess.Set=
>{Mk MkExtend Lex.ReceiverMkSet=EgVectProcess2.FindAnd Console.OutLn="EgVectProcess Mk" Cons.OutLn="EgVectProcess Mk"}
>{Var Lex.ReceiverMkSet=EgVectProcess2.FindAnd Console.OutLn="EgVectProcess Var" Cons.OutLn="EgVectProcess Var"}
>{0 Lex.Stop Console.OutLn="SYNTAX ERROR EgVectProcess: Mk or Var expected" Cons.OutLn="EgVectProcess ERR"}

\**\EgVectProcess2.Set=
>{Sep="," Lex.ReceiverMkSet=EgVectProcess.FindAnd Console.OutLn="EgVectProcess2 , (loop)" Cons.OutLn="EgVectProcess2 , loop"}
>{Sep="=" Lex.ReceiverMkSet=AleEgAfter.FindAnd Console.OutLn="EgVectProcess2 =" Cons.OutLn="EgVectProcess2 ="}
>{0 Lex.Stop Console.OutLn="SYNTAX ERROR EgVectProcess2: ',' or '=' expected" Cons.OutLn="EgVectProcess2 ERR"}

\**\FuncAfter.Set=
>{Sep="(" Stack.LineCopyAdd={Sep="("} Lex.ReceiverMkSet=AleEgAfter.FindAnd Console.OutLn="FuncAfter (" Cons.OutLn="FuncAfter ("}
>{Var Const ConstInt ConstFloat Vect Lex.ReceiverMkSet=OperatWait.FindAnd Console.OutLn="FuncAfter operand" Cons.OutLn="FuncAfter operand"}
>{0 Lex.Stop Console.OutLn="SYNTAX ERROR FuncAfter: '(' or operand expected" Cons.OutLn="FuncAfter ERR"}

\**\VectAfter.Set=
>{Sep="[" Stack.LineCopyAdd={Sep="["} Lex.ReceiverMkSet=AleEgAfter.FindAnd Console.OutLn="VectAfter [" Cons.OutLn="VectAfter ["}
>{Sep="++" Sep="--" Lex.ReceiverMkSet=Root.FindAnd Console.OutLn="VectAfter ++/-- (End)" Cons.OutLn="VectAfter ++/-- End"
  FUListNew.ReceivedOutMk=Lex.SendToReceiver}
>{0 Lex.Stop Console.OutLn="SYNTAX ERROR VectAfter: '[', '++' or '--' expected" Cons.OutLn="VectAfter ERR"}

\**\VectAfter2.Set=
>{Operator Lex.ReceiverMkSet=AleEgAfter.FindAnd Console.OutLn="VectAfter2 Operator" Cons.OutLn="VectAfter2 Operator"}
>{Sep="+" Sep="-" Sep="*" Sep="/" Sep="//" Sep="%"
  Lex.ReceiverMkSet=AleEgAfter.FindAnd Console.OutLn="VectAfter2 op" Cons.OutLn="VectAfter2 op"}
>{Sep="[" Stack.LineCopyAdd={Sep="["} Lex.ReceiverMkSet=AleEgAfter.FindAnd Console.OutLn="VectAfter2 [" Cons.OutLn="VectAfter2 ["}
>{0 Lex.ReceiverMkSet=Root.FindAnd Console.OutLn="VectAfter2 End -> Root" Cons.OutLn="VectAfter2 End -> Root"
  FUListNew.ReceivedOutMk=Lex.SendToReceiver}

\**\EqAfter.Set=
>{Mk MkExtend Lex.ReceiverMkSet=EqAfter2.FindAnd Console.OutLn="EqAfter Mk" Cons.OutLn="EqAfter Mk"}
>{Var Lex.ReceiverMkSet=EqAfter2.FindAnd Console.OutLn="EqAfter Var" Cons.OutLn="EqAfter Var"}
>{0 Lex.ReceiverMkSet=AleEgAfter.FindAnd Console.OutLn="EqAfter else -> AleEgAfter" Cons.OutLn="EqAfter else -> AleEgAfter"
  FUListNew.ReceivedOutMk=Lex.SendToReceiver}

\**\EqAfter2.Set=
>{Sep="=" Lex.ReceiverMkSet=EqAfter.FindAnd Console.OutLn="EqAfter2 = (loop)" Cons.OutLn="EqAfter2 = loop"}
>{0 Lex.ReceiverMkSet=AleEgAfter.FindAnd Console.OutLn="EqAfter2 else -> AleEgAfter" Cons.OutLn="EqAfter2 else -> AleEgAfter"
  FUListNew.ReceivedOutMk=Lex.SendToReceiver}
