# V#1,2,3,4,5 -- five-element vector via VectNext5 ',' -> VectNext4 loop
Root Mnemo
MnemoAnalysis #
ConstWait -> VectWait
VectWait ,
VectNext4 element added
VectNext5 ,
VectNext4 element added
VectNext5 ,
VectNext4 element added
VectNext5 ,
VectNext4 element added
# Vec2#10,20 -- second statement starts; the VectNext5 of the previous one
# spills into Mnemo dispatch via FailProg.
Root Mnemo
VectNext5 else->Root
MnemoAnalysis #
ConstWait -> VectWait
VectWait ,
VectNext4 element added
VectNext5 else->Root
