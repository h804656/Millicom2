# A=1 setup
Root Mnemo
MnemoAnalysis =
VarIniWait Const
# Atr=Helper(A) -- MnemoLoad ( -> LoadVar -> BrackLoadVar )
Root Mk/Atr
EqualWait =
EqualAfter Mnemo
MnemoLoad (
LoadVar Const/Var/Vect
BrackLoadVar )
# Atr=NewObj{X=1} -- MnemoLoad { subgraph
Root Mk/Atr
EqualWait =
EqualAfter Mnemo
MnemoLoad {
Root Mnemo
MnemoAnalysis =
VarIniWait Const
Root }
# Atr=Wrapper>z -- MnemoLoad > <, ListAfter Mnemo
Root Mk/Atr
EqualWait =
EqualAfter Mnemo
MnemoLoad > <
ListAfter Mnemo
# next 'Atr' lands at ListAfterMnemo: it ISN'T '{', so the else row fires and
# the Atr token is forwarded to ListAfter; ListAfter sees Atr (Mk/Atr atr-row).
ListAfter Mk/Atr/Const/Var
ListAfterMnemo else
