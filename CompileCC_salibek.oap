NewFU={Mnemo="ALEStart" FUType=FUListNew Hint="Начальное состояние распознания АЛВ"}
NewFU={Mnemo="ICBrackAnalysis" FUType=FUListNew Hint="Анализ фигурной закрывающейся скобки"}
NewFU={Mnemo="DelMnemoWait" FUType=FUListNew Hint="Анализ фигурной закрывающейся скобки"}
NewFU={Mnemo="DelMnemoIcWait" FUType=FUListNew Hint="Анализ фигурной закрывающейся скобки"}

MainBus.PartialResetSet \\ Запомнить число созданных ФУ
MainBus.ModeSet=2

\\Console.OutLn="CompileCC"

Sep*-4
Var*-14
MkExec*-304 // МК для последующего выполнения
MkExtend*-25 // Расширенная МК
End*-27 \\ Конец чего-либо
FUTemplate*-303 \\ Ссылка на эталонное ФУ для создания нового ФУ
FU
IC*IcPointer
IP*-330
ProgAtr*-331

NewFUAtr \\ Флаг создания нового устройства
\\Типы указательй на нагрзуки
TAtrType#36
CAtrType#37
TMkType#26
CMkType#27
TIpType#14
CIpType#15
TIcType#16
CIcType#17
TIntType#6
CIntType#7
TBoolType#2
CBoolType#3
TCharType#4
CCharType#5
TFloatType#8
CFloatType#9
TDoubleType#10
CDoubleType#11
TStrType#12
CStrType#13
TFuType#22
CFuType#23
TLoadType#22
CLoadType#23
TLoadVectType#28
CLoadVectType#29
