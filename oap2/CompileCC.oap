>{Const Var Vect Lex.ReceiverMkSet=ALEAfter.FindAnd
  FUListNew.ReceivedLoadOutMk=AleOp.Mul Console.OutLn="AleMul operand"}
>{Sep="(" Lex.ReceiverPush=ALE.FindAnd
  AleResult.Push=0 AleOp.Push=0 Stack.LineCopyAdd={Sep="("} Console.OutLn="AleMul ("}
