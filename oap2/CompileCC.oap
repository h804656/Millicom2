\**\LoadAfter.Set=
>{Sep="=" Lex.ReceiverMkSet=EqualAfter.FindAnd
  MkCalc.OutMk=OAList.LastAtrAttach
  Console.OutLn="LoadAfter ="
}
>{0 Lex.ReceiverMkSet=Root.FindAnd
  MkCalc.OutMk=OAList.LastLoadSet
  FUListNew.ReceivedOutMk=Root.FindAnd
  Console.OutLn="LoadAfter else->Root"
}


\**\ListAfter.Set=
>{Sep="{" Lex.ReceiverMkSet=Root.FindAnd
  Stack.LineCopyAdd={Sep="{"}
  OAList.LineAdd
  OAList.LineCopyAddPrevSet
  Console.OutLn="ListAfter {"
}
>{Mk Atr Const Var Lex.ReceiverMkSet=Root.FindAnd
  FUListNew.LoadOutMk=OAList.LastLoadSet
  Console.OutLn="ListAfter Mk/Atr/Const/Var"
}
>{Mnemo Lex.ReceiverMkSet=ListAfterMnemo.FindAnd
  FUListNew.ReceivedOutMk=MnemoTable.LineCopyAdd
  MnemoTable.LastAttach={Lex.SendToReceiver}
  Console.OutLn="ListAfter Mnemo"
}
>{Sep=">" Sep="<" Lex.ReceiverMkSet=ListAfter.FindAnd
  Console.OutLn="ListAfter > <"
}
>{0 Lex.ReceiverMkSet=Root.FindAnd
  FUListNew.ReceivedOutMk=Lex.SendToReceiver
}


\**\ListAfterMnemo.Set=
>{Sep="{" Lex.ReceiverMkSet=Root.FindAnd
  Stack.LineCopyAdd={Sep="{"}
  MnemoTable.LineCopyAddPrevLoadSet={IC}
  OAList.LineAdd
  OAList.LineCopyAddPrevSet
  OAList.LastOutMk=MnemoTable.LastLoadSet
  MnemoTable.LastPopMk
  Console.OutLn="ListAfterMnemo {"
}
>{0 Lex.ReceiverMkSet=ListAfter.FindAnd
  FUListNew.ReceivedOutMk=Lex.SendToReceiver
  Console.OutLn="ListAfterMnemo else"
}

////////////////////////////////////////////////////////////////////////////////
// ALE / ALEAfter: a two-state arithmetic-expression sub-automaton.

\**\ALE.Set=
>{Const Var Vect
  Lex.ReceiverMkSet=ALEAfter.FindAnd
  Console.OutLn="ALE operand"
}
>{Sep="("
  Stack.LineCopyAdd={Sep="("}
  Console.OutLn="ALE ("
}
>{Sep="-" Sep="+"
  Console.OutLn="ALE unary"
}
>{0 Lex.ReceiverMkSet=Root.FindAnd
  FUListNew.ReceivedOutMk=Lex.SendToReceiver
  Console.OutLn="ALE done -> Root"
}

\**\ALEAfter.Set=
>{Operator Sep="+" Sep="-" Sep="*" Sep="/" Sep="%"
  Lex.ReceiverMkSet=ALE.FindAnd
  Console.OutLn="ALEAfter op"
}
>{Sep=")"
  Stack.FindAndLast={Sep="("}
  Stack.SuccessExec={Stack.LastDelMk Console.OutLn="ALEAfter )"}
  Stack.FailExec={Lex.ReceiverMkSet=Root.FindAnd FUListNew.ReceivedOutMk=Lex.SendToReceiver Console.OutLn="ALEAfter done -> Root"}
}
>{0 Lex.ReceiverMkSet=Root.FindAnd
  FUListNew.ReceivedOutMk=Lex.SendToReceiver
  Console.OutLn="ALEAfter done -> Root"
}

////////////////////////////////////////////////////////////////////////////////
Lex.ReceiverMkSet=Root.FindAnd

