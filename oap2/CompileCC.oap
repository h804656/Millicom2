>{Mk=20 Mnemo="NFUOut" Hint="Вывод количества ФУ, зарегистрированных на шине"}
>{Mk=21 Mnemo="NFUOutMk" Hint="Вывод ФУ с количеством МК, зарегистрированных на шине"}
>{Mk=25 Mnemo="LastFUNameSet" Hint="Set the name of the most-recently-created FU"}
>{Mk=40 Mnemo="LastFUMkRangeOut" Hint="Write the most-recent FU's MK range to Load"}
>{Mk=41 Mnemo="LastFUMkRangeOutMk" Hint="Dispatch the most-recent FU's MK range via Load MK"}
>{Mk=155 Mnemo="FUTypeCorrectSet" Hint="Set FU type correction offset"}
>{Mk=253 Mnemo="IpBufWrite"      Hint="Сериализовать буфер в .ind"}
>{Mk=287 Mnemo="CapsListRegister" Hint="Capture the CapsList FU pointer on the Bus (dispatch with Sender=CapsList)"}


