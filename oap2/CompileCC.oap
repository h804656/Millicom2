>{Mk=169 Mnemo="LastLoadOutMk"     Hint="Dispatch last ip load via Load MK"}
>{Mk=161 Mnemo="LineCopyAdd"       Hint="Copy-add new line"}
>{Mk=170 Mnemo="LastAttach"        Hint="Attach IP to the last line's body"}
>{Mk=174 Mnemo="LastLoadConstVarTypeSet" Hint="Mark last line load as Const/Var typed"}
>{Mk=185 Mnemo="LastLoadSet"       Hint="Set Load of the last line"}
>{Mk=186 Mnemo="LastLoadCopySet"   Hint="Set Load (copy) of the last line"}
>{Mk=189 Mnemo="LastAtrSet"        Hint="Set atr of the last line"}
>{Mk=192 Mnemo="LineCopyAddPrevSet" Hint="Set prev-line copy source"}
>{Mk=210 Mnemo="LastAtrAttach"     Hint="Attach atr to last line as field"}
>{Mk=220 Mnemo="FindOrLast"        Hint="OR-search, return last match"}
>{Mk=222 Mnemo="FindAndLast"       Hint="AND-search, return last match"}
>{Mk=228 Mnemo="FindOr"            Hint="OR-search across rows"}
>{Mk=229 Mnemo="FindAnd"           Hint="AND-search across rows"}
>{Mk=243 Mnemo="PushTied"          Hint="Push tied sub-list"}
>{Mk=244 Mnemo="PushTiedCopy"      Hint="Push tied sub-list (copy)"}
>{Mk=262 Mnemo="PopMkDel"          Hint="Pop, dispatch via Load MK, delete"}
>{Mk=285 Mnemo="LastAtrOut"        Hint="Write last line's atr to Load"}
