// ALE

\**\ALE.Set=
>{Const Var Vect
  Lex.ReceiverMkSet=ALEAfter.FindAnd
  FUListNew.ReceivedLoadOutMk=AleOp.Set
  Console.OutLn="ALE operand"
}
>{Sep="(" Lex.ReceiverPush=ALE.FindAnd
  AleResult.Push=0 AleOp.Push=0 Stack.LineCopyAdd={Sep="("}
  Console.OutLn="ALE ("
}
>{AleParenVal Lex.ReceiverMkSet=ALEAfter.FindAnd
  AleTmp.OutMk=AleOp.Set
  Console.OutLn="ALE parenVal"
}
>{Sep="-" Lex.ReceiverMkSet=AleNegWait.FindAnd Console.OutLn="ALE unary"}
>{Sep="+" Lex.ReceiverMkSet=ALE.FindAnd Console.OutLn="ALE unary"}
>{0 Lex.Stop Console.OutLn="SYNTAX ERROR ALE: operand or '(' expected"
  FUListNew.ReceivedOutMk=Console.OutLn
  ProgStopAll
}

\**\ALEAfter.Set=
>{Sep="+" Lex.ReceiverMkSet=ALE.FindAnd
  AleOp.OutMk=AleResult.Add
  Console.OutLn="ALEAfter op"
}
>{Sep="-" Lex.ReceiverMkSet=AleNegWait.FindAnd
  AleOp.OutMk=AleResult.Add
  Console.OutLn="ALEAfter op"
}
>{Sep="*" Lex.ReceiverMkSet=AleMulWait.FindAnd
  Console.OutLn="ALEAfter op"
}
>{Sep="/" Lex.ReceiverMkSet=AleDivWait.FindAnd
  Console.OutLn="ALEAfter op"
}
>{Sep="%" Lex.ReceiverMkSet=AleModWait.FindAnd
  Console.OutLn="ALEAfter op"
}
>{Operator Lex.ReceiverMkSet=ALE.FindAnd
  AleOp.OutMk=AleResult.Add
  Console.OutLn="ALEAfter op"
}
>{Sep=")"
  Stack.FindAndLast={Sep="("}
  Stack.SuccessExec={AleOp.OutMk=AleResult.Add
                     AleResult.OutMk=AleTmp.Set
                     AleResult.Pop=0
                     AleOp.Pop=0
                     Stack.LastDelMk
                     Lex.ReceiverPop
                     Lex.SendToReceiver={AleParenVal}
                     Console.OutLn="ALEAfter )"}
  Stack.FailExec={Lex.ReceiverMkSet=Root.FindAnd
                  AleOp.OutMk=AleResult.Add
                  MkCalc.OutMk=CapsList.LineAtrDef
                  AleResult.OutMk=CapsList.LineAdd
                  MkCalc.NEQExec={CapsDepth.LessEQExec={CapsList.MarkLastOutMk=Main_Bus.MkExec}}
                  MkCalc.Set=0
                  FUListNew.ReceivedOutMk=Lex.SendToReceiver
                  Console.OutLn="ALEAfter done -> Root"}
}
>{Sep="]"
  Stack.FindAndLast={Sep="["}
  Stack.SuccessExec={Stack.LastDelMk
                     AleOp.OutMk=AleResult.Add
                     AleResult.OutMk=MnemoTable.LastLoadSet
                     MnemoTable.LastLoadConstVarTypeSet=0
                     MnemoTable.LastPopMk
                     Lex.ReceiverMkSet=Root.FindAnd
                     Console.OutLn="ALEAfter ] -> var bound"}
  Stack.FailExec={Lex.Stop
                  Console.OutLn="SYNTAX ERROR ALEAfter: ']' without matching '['"
                  ProgStopAll}
}
>{0 Lex.ReceiverMkSet=Root.FindAnd
  AleOp.OutMk=AleResult.Add
  MkCalc.OutMk=CapsList.LineAtrDef
  AleResult.OutMk=CapsList.LineAdd
  MkCalc.NEQExec={CapsDepth.LessEQExec={CapsList.MarkLastOutMk=Main_Bus.MkExec}}
  MkCalc.Set=0
  FUListNew.ReceivedOutMk=Lex.SendToReceiver
  Console.OutLn="ALEAfter done -> Root"
}

