>{Mk=425 Mnemo="LastIpPopMk"       Hint="Pop last IP, dispatch via Load MK"}

// MnemoListMkTable: an exact duplicate of ListMkTable, used ONLY by the
// "MnemoTable" self-row below. The .ind serializer (MakeIndexVect in
// MainUnit.pas) does NOT dedup a shared IC: a named table referenced by two
// `!` pointers gets walked twice and corrupts the index vector (-1 refs ->
// truncated .ind). ListMkTable is already `!`-shared by ListPeer, so the
// MnemoTable row needs its own distinct copy. KEEP IN SYNC WITH ListMkTable.
\**\MnemoListMkTable
>{Mk=1   Mnemo="Set"               Hint="Replace current line with new IC"}
>{Mk=2   Mnemo="Out"               Hint="Write current line to Load"}
>{Mk=3   Mnemo="OutMk"             Hint="Dispatch current line via Load MK"}
>{Mk=5   Mnemo="MultiLineModeSet"  Hint="Toggle multi-line search mode"}
>{Mk=7   Mnemo="MkModeSet"         Hint="On FindAnd/FindOr success run matched row body as a program"}
>{Mk=8   Mnemo="EmptyProgExec"     Hint="Exec Load if list is empty"}
>{Mk=9   Mnemo="FullExec"          Hint="Exec Load if list is non-empty"}
>{Mk=12  Mnemo="SuccessProgSet"    Hint="Program to run on Find success"}
>{Mk=17  Mnemo="FailProgSet"       Hint="Set program to run on Find failure"}
>{Mk=23  Mnemo="SuccessExec"       Hint="Exec Load if last find succeeded"}
>{Mk=24  Mnemo="FailExec"          Hint="Exec Load if last find failed"}
>{Mk=151 Mnemo="LastPop"           Hint="Pop the last line"}
>{Mk=156 Mnemo="LastPopMk"         Hint="Pop the last line, dispatch via Load MK"}
>{Mk=157 Mnemo="LastDelMk"         Hint="Delete the last line"}
>{Mk=21  Mnemo="LineAtrDef"        Hint="Set default line atr applied by the next LineAdd"}
>{Mk=160 Mnemo="LineAdd"           Hint="Append new line"}
>{Mk=169 Mnemo="LastLoadOutMk"     Hint="Dispatch last ip load via Load MK"}
>{Mk=161 Mnemo="LineCopyAdd"       Hint="Copy-add new line"}
>{Mk=170 Mnemo="LastAttach"        Hint="Attach IP to the last line's body"}
>{Mk=174 Mnemo="LastLoadConstVarTypeSet" Hint="Mark last line load as Const/Var typed"}
>{Mk=185 Mnemo="LastLoadSet"       Hint="Set Load of the last line"}
>{Mk=186 Mnemo="LastLoadCopySet"   Hint="Set Load (copy) of the last line"}
>{Mk=189 Mnemo="LastAtrSet"        Hint="Set atr of the last line"}
>{Mk=192 Mnemo="LineCopyAddPrevSet" Hint="Set prev-line copy source"}
>{Mk=210 Mnemo="LastAtrAttach"     Hint="Attach atr to last line as field"}
>{Mk=220 Mnemo="FindOrLast"        Hint="OR-search, return last match"}
>{Mk=222 Mnemo="FindAndLast"       Hint="AND-search, return last match"}
>{Mk=228 Mnemo="FindOr"            Hint="OR-search across rows"}
>{Mk=229 Mnemo="FindAnd"           Hint="AND-search across rows"}
>{Mk=243 Mnemo="PushTied"          Hint="Push tied sub-list"}
>{Mk=244 Mnemo="PushTiedCopy"      Hint="Push tied sub-list (copy)"}
>{Mk=262 Mnemo="PopMkDel"          Hint="Pop, dispatch via Load MK, delete"}
>{Mk=285 Mnemo="LastAtrOut"        Hint="Write last line's atr to Load"}
>{Mk=286 Mnemo="LastAtrOutMk"      Hint="Dispatch last line's atr via Load MK"}
>{Mk=425 Mnemo="LastIpPopMk"       Hint="Pop last IP, dispatch via Load MK"}

\**\LexMkTable
>{Mk=0   Mnemo="Reset"          Hint="Reset Lex state"}
>{Mk=2   Mnemo="ReceiverPush"   Hint="Push current Receiver, set new from Load"}
>{Mk=3   Mnemo="ReceiverPop"    Hint="Pop Receiver and dispatch MK"}
>{Mk=5   Mnemo="ReceiverMkSet"  Hint="Set Receiver's dispatch MK"}
>{Mk=10  Mnemo="ErrProgSet"     Hint="Set program for lex error"}
>{Mk=13  Mnemo="StopProgSet"    Hint="Set program for Lex.Stop"}
>{Mk=15  Mnemo="UnicAtrSet"     Hint="Set a unique-atr dispatch slot"}
>{Mk=16  Mnemo="UnicMkSet"      Hint="Set the MK for the current unic-atr slot"}
>{Mk=17  Mnemo="UnicFuSet"      Hint="Set the FU for the current unic-atr slot"}
>{Mk=21  Mnemo="SepSet"         Hint="Register a Sep token literal"}
>{Mk=22  Mnemo="SepErase"       Hint="Remove a Sep token literal"}
>{Mk=70  Mnemo="SendToReceiver" Hint="Dispatch current LexBuf entry to Receiver"}
>{Mk=100 Mnemo="Lexing"         Hint="Feed string into Lex for tokenization"}

\**\IntAluMkTable
>{Mk=1   Mnemo="Set"     Hint="Set accumulator"}
>{Mk=5   Mnemo="Push"    Hint="Push accumulator, set to Load"}
>{Mk=8   Mnemo="Pop"     Hint="Pop accumulator into Load"}
>{Mk=9   Mnemo="PopMk"   Hint="Pop, dispatch popped value via Load MK"}
>{Mk=20  Mnemo="Out"     Hint="Out accumulator into Load"}
>{Mk=21  Mnemo="OutMk"   Hint="Dispatch accumulator via Load MK"}
>{Mk=60  Mnemo="EQExec"  Hint="Exec Load if accum != compare (NB: bug in IntAlu)"}
>{Mk=61  Mnemo="NEQExec" Hint="Exec Load if accum != compare"}
>{Mk=140 Mnemo="Add"     Hint="Add Load to accumulator"}
>{Mk=141 Mnemo="Sub"     Hint="Subtract Load from accumulator"}
>{Mk=142 Mnemo="Mul"     Hint="Multiply accumulator by Load"}
>{Mk=143 Mnemo="Div"     Hint="Divide accumulator by Load"}
>{Mk=144 Mnemo="Mod"     Hint="Modulo accumulator by Load"}

