>{Mk=24  Mnemo="FailExec"          Hint="Exec Load if last find failed"}
>{Mk=151 Mnemo="LastPop"           Hint="Pop the last line"}
>{Mk=156 Mnemo="LastPopMk"         Hint="Pop the last line, dispatch via Load MK"}
>{Mk=157 Mnemo="LastDelMk"         Hint="Delete the last line"}
>{Mk=21  Mnemo="LineAtrDef"        Hint="Set default line atr applied by the next LineAdd"}
