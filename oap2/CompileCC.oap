}
>{Sep="("
  AleResult.Set=0
  Lex.ReceiverPush=ALE.FindAnd
  AleResult.Push=0 AleOp.Push=0 Stack.LineCopyAdd={Sep="("}
  Console.OutLn="EqualAfter ( -> ALE"
}
>{AleParenVal Lex.ReceiverMkSet=ALEAfter.FindAnd
  AleTmp.OutMk=AleOp.Set
