\**\BrackLoadVar.Set=
>{Operator Sep="+" Sep="-" Sep="*" Sep="/" Sep="%"
  Lex.ReceiverPush=ALEAfter.FindAnd
  FUListNew.ReceivedOutMk=Lex.SendToReceiver
  Console.OutLn="BrackLoadVar Operator -> ALE"
}
>{Sep=")" Lex.ReceiverMkSet=Root.FindAnd
