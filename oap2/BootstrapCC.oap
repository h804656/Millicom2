NewFU={Mnemo="MnemoTable" FUType=FUListNew Hint="Таблица мнемоник"}
NewFU={Mnemo="Lex"        FUType=FULexNew  Hint="Лексический анализатор"}

MnemoTable.Set=
>{Mnemo="Atr"    Lex.SendToReceiver={Atr=Atr}}
>{Mnemo="Mnemo"  Lex.SendToReceiver={Atr=Mnemo}}
>{Mnemo="FUType" Lex.SendToReceiver={Atr=FUType}}
>{Mnemo="Hint"   Lex.SendToReceiver={Atr=Hint}}
>{Mnemo="pi"     ConstFloat=3.14159}

// Atr-typed names (token atr code = N):
MnemoTable.LineAdd={Mnemo="Operand"      Lex.SendToReceiver={Atr=-1}}
MnemoTable.LineAdd={Mnemo="Mnemo"        Lex.SendToReceiver={Atr=-2}}
MnemoTable.LineAdd={Mnemo="Obj"          Lex.SendToReceiver={Atr=-6}}
MnemoTable.LineAdd={Mnemo="Atr"          Lex.SendToReceiver={Atr=-8}}
MnemoTable.LineAdd={Mnemo="ConstInt"     Lex.SendToReceiver={Atr=-10}}
MnemoTable.LineAdd={Mnemo="ConstFloat"   Lex.SendToReceiver={Atr=-11}}
MnemoTable.LineAdd={Mnemo="Const"        Lex.SendToReceiver={Atr=-13}}
MnemoTable.LineAdd={Mnemo="VarPointer"   Lex.SendToReceiver={Atr=-14}}
MnemoTable.LineAdd={Mnemo="IcPointer"    Lex.SendToReceiver={Atr=-15}}
MnemoTable.LineAdd={Mnemo="AtrPointer"   Lex.SendToReceiver={Atr=-18}}
MnemoTable.LineAdd={Mnemo="MkBegRange"   Lex.SendToReceiver={Atr=-20}}
MnemoTable.LineAdd={Mnemo="MkList"       Lex.SendToReceiver={Atr=-21}}
MnemoTable.LineAdd={Mnemo="FUType"       Lex.SendToReceiver={Atr=-22}}
MnemoTable.LineAdd={Mnemo="FUTypeList"   Lex.SendToReceiver={Atr=-23}}
MnemoTable.LineAdd={Mnemo="Mk"           Lex.SendToReceiver={Atr=-24}}
MnemoTable.LineAdd={Mnemo="Exeption"     Lex.SendToReceiver={Atr=-40}}
MnemoTable.LineAdd={Mnemo="Hint"         Lex.SendToReceiver={Atr=-42}}
MnemoTable.LineAdd={Mnemo="Comment"      Lex.SendToReceiver={Atr=-54}}
MnemoTable.LineAdd={Mnemo="FUContext"    Lex.SendToReceiver={Atr=-57}}
MnemoTable.LineAdd={Mnemo="PointPointer" Lex.SendToReceiver={Atr=-63}}
MnemoTable.LineAdd={Mnemo="MkTree"       Lex.SendToReceiver={Atr=-64}}
MnemoTable.LineAdd={Mnemo="ListPointer"  Lex.SendToReceiver={Atr=-66}}
MnemoTable.LineAdd={Mnemo="CounterAtr"   Lex.SendToReceiver={Atr=-68}}
MnemoTable.LineAdd={Mnemo="FUName"       Lex.SendToReceiver={Atr=-69}}
MnemoTable.LineAdd={Mnemo="FUTypeDef"    Lex.SendToReceiver={Atr=-70}}
MnemoTable.LineAdd={Mnemo="NameAtr"      Lex.SendToReceiver={Atr=-80}}

// Mk-typed names (resolves to a positive Mk value on the current FU):
MnemoTable.LineAdd={Mnemo="RepeatProg"   Lex.SendToReceiver={Mk=901}}
MnemoTable.LineAdd={Mnemo="ElseProgSet"  Lex.SendToReceiver={Mk=953}}
MnemoTable.LineAdd={Mnemo="ProgSetExec"  Lex.SendToReceiver={Mk=954}}
MnemoTable.LineAdd={Mnemo="ProgStopAll"  Lex.SendToReceiver={Mk=988}}
MnemoTable.LineAdd={Mnemo="ProgStop"     Lex.SendToReceiver={Mk=989}}
MnemoTable.LineAdd={Mnemo="ProgExec"     Lex.SendToReceiver={Mk=990}}
MnemoTable.LineAdd={Mnemo="ProgSet"      Lex.SendToReceiver={Mk=991}}
